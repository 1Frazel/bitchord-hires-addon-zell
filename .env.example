# ============================================================================
# BitChord Private Hi-Res Addon (Cloudflare R2 + Vercel)
# ============================================================================

# 1. Cloudflare R2 Credentials
# Account ID and S3 API Endpoint are pre-configured by default:
R2_ACCOUNT_ID=9320408c0a85e91646716a015a3f9b60
R2_ENDPOINT=https://9320408c0a85e91646716a015a3f9b60.r2.cloudflarestorage.com

# Generate an R2 API Token at: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# Permission needed: "Object Read & Write" (or "Admin Read & Write")
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Name of your R2 bucket (if left blank, the server will auto-detect your bucket)
R2_BUCKET_NAME=bitchord-hires

# Optional: Public R2 domain (e.g., https://pub-xxx.r2.dev or custom domain).
# Leave blank to keep your R2 bucket 100% private using automatic Presigned URLs!
R2_PUBLIC_URL=

# 2. Security & Private Access
# Password to log into the Web Management Dashboard (default: admin123 if unset)
ADMIN_PASSWORD=your_strong_dashboard_password

# Optional secret slug in your BitChord Addon URL:
# e.g., https://your-app.vercel.app/<ADDON_SECRET>/manifest.json
ADDON_SECRET=zell-private
