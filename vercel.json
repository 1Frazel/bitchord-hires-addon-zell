{
  "version": 2,
  "rewrites": [
    { "source": "/manifest.json", "destination": "/api?__path=/manifest.json" },
    { "source": "/addon.json", "destination": "/api?__path=/addon.json" },
    { "source": "/search", "destination": "/api?__path=/search" },
    { "source": "/health", "destination": "/api?__path=/health" },
    { "source": "/stream/(.*)", "destination": "/api?__path=/stream/$1" },
    { "source": "/file/(.*)", "destination": "/api?__path=/file/$1" },
    { "source": "/art/(.*)", "destination": "/api?__path=/art/$1" },
    { "source": "/api/(.*)", "destination": "/api?__path=/api/$1" },
    { "source": "/([^/]+)/manifest.json", "destination": "/api?__path=/$1/manifest.json" },
    { "source": "/([^/]+)/addon.json", "destination": "/api?__path=/$1/addon.json" },
    { "source": "/([^/]+)/search", "destination": "/api?__path=/$1/search" },
    { "source": "/([^/]+)/health", "destination": "/api?__path=/$1/health" },
    { "source": "/([^/]+)/stream/(.*)", "destination": "/api?__path=/$1/stream/$2" },
    { "source": "/([^/]+)/file/(.*)", "destination": "/api?__path=/$1/file/$2" },
    { "source": "/([^/]+)/art/(.*)", "destination": "/api?__path=/$1/art/$2" }
  ]
}
